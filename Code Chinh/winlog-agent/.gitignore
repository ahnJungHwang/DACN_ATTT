# Môi trường ảo Python
.venv/
venv/

# Cache Python
__pycache__/
*.py[cod]

# Bộ dataset EVTX mẫu ngoài (60MB+)
dataset/

# Log thu thập trực tiếp từ máy thật
data/client_*_live/
data/realtime_live/

# Kết quả JSON thô của từng lần chạy (chỉ giữ lại báo cáo tổng hợp .md và .csv trong results/)
results/*/
# ...trừ báo cáo benchmark 600 ca (chỉ chứa CSV tổng hợp)
!results/benchmark600/
# Số liệu benchmark của bản update cũ: chỉ giữ các file CSV (bỏ raw_eval_logs/ và .md)
!results/benchmark600_update_old/
results/benchmark600_update_old/*
!results/benchmark600_update_old/*.csv

# Cửa sổ sự kiện SQLite (core/event_store.py, bật bằng EVENT_WINDOW_SECONDS)
data/*.db
data/*.db-shm
data/*.db-wal

# Khóa bí mật / chứng chỉ SSL / cấu hình cục bộ
key.pem
cert.pem
.env
*.env

# File tạm của Office / hệ điều hành
~$*
Thumbs.db
.DS_Store

# Tài liệu tham khảo nội bộ
Bao_cao_huong_trien_khai_AI_Agent_Windows_Local_SLM.docx


# Ca kiem thu sinh tu EVTX that (tao lai bang eval_real/build_cases.ps1)
eval_real/cases/
eval_real/colab_pack.zip

# File sinh ra khi chay client agent
client_agent.log
client_agent.pid

# Công cụ + dữ liệu EVTX bên thứ ba (DeepBlueCLI, EVTX-ATTACK-SAMPLES, evtx-baseline; ~1,8GB, GPL-3.0)
tools_rule_baseline/
