# Cấu hình máy SERVER (máy Windows thật). Copy thành .env rồi sửa giá trị.
# run_server.bat / run_server_https.bat tự nạp file .env này.
# Không để dấu cách quanh dấu "=", không dùng dấu nháy.

# Module FastAPI chạy: app = phân tích trực tiếp + Telegram từ Python
#                      app1 = chuyển log qua n8n điều phối (n8n gọi ngược /ingest)
APP_MODULE=app1

# Ollama chạy trên chính máy server
OLLAMA_URL=http://127.0.0.1:11434/api/chat
MAX_BATCH_CHARS=15000

# n8n chạy trong Docker (container "n8n" đang map cổng 5678; docker-compose.yml dùng 5679)
N8N_WEBHOOK_URL=http://127.0.0.1:5678/webhook/windows-log

# Telegram (chỉ app.py dùng; app1 để n8n gửi)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Mạng lab VMware NAT (VMnet8) - chỉ để tham khảo
# Server: 192.168.147.1  |  Client Win10 VM: 192.168.147.136
