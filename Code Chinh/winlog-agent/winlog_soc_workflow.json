{
  "name": "WinLog SOC - windows-log",
  "id": "winlogSocWebhook1",
  "active": false,
  "settings": { "executionOrder": "v1" },
  "nodes": [
    {
      "id": "a1000000-0000-4000-8000-000000000001",
      "name": "Webhook windows-log",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "webhookId": "5d0c6f0e-7a51-4c1e-9a31-0f2f5b8e7a01",
      "parameters": {
        "httpMethod": "POST",
        "path": "windows-log",
        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "id": "a1000000-0000-4000-8000-000000000002",
      "name": "AI Analyze (Server /ingest)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [240, 0],
      "parameters": {
        "method": "POST",
        "url": "https://host.docker.internal:8443/ingest",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [ { "name": "x-n8n-request", "value": "true" } ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body) }}",
        "options": {
          "allowUnauthorizedCerts": true,
          "timeout": 600000
        }
      }
    },
    {
      "id": "a1000000-0000-4000-8000-000000000003",
      "name": "Is ALERT?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [480, 0],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "typeValidation": "loose" },
          "combinator": "and",
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.verdict.label }}",
              "rightValue": "ALERT",
              "operator": { "type": "string", "operation": "equals" }
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "a1000000-0000-4000-8000-000000000004",
      "name": "Telegram Alert",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [720, -120],
      "onError": "continueRegularOutput",
      "credentials": {
        "telegramApi": { "id": "rFNcHEVx81X5OkpZ", "name": "Telegram DACNAIagentbot" }
      },
      "parameters": {
        "chatId": "6205012466",
        "text": "={{ $json.text }}",
        "additionalFields": { "appendAttribution": false, "parse_mode": "HTML" }
      }
    },
    {
      "id": "a1000000-0000-4000-8000-000000000006",
      "name": "Build Alert Text",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [600, -120],
      "parameters": {
        "jsCode": "const esc = (s) => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst r = $json;\nconst v = r.verdict || {};\nconst stages = (v.detected_stages || []).join(', ') || 'Không xác định';\nconst ev = (v.evidence_refs || []).join(', ') || 'N/A';\nlet reason = String(v.reason || '');\nif (reason.length > 3000) reason = reason.slice(0, 3000) + '…';\nconst text = [\n  '🚨 <b>CẢNH BÁO BẢO MẬT TỪ CLIENT</b> 🚨',\n  '',\n  `🖥️ <b>Máy:</b> <code>${esc(r.hostname)}</code> (<code>${esc(r.client_id)}</code>)`,\n  `🕒 <b>Thời gian:</b> ${esc(new Date().toLocaleString('vi-VN', { timeZone: 'Asia/Ho_Chi_Minh' }))}`,\n  `⚠️ <b>Kết luận:</b> <b>${esc(v.label)}</b>`,\n  `⏱️ <b>AI xử lý:</b> ${esc(r.elapsed_seconds)}s`,\n  `🎯 <b>Giai đoạn:</b> ${esc(stages)}`,\n  `🧠 <b>Nguồn quyết định:</b> ${esc(({ 'rule+ai': 'Bộ luật + AI xác nhận', 'ai': 'AI tự phát hiện (đã tự thẩm định)', 'rule': 'Bộ luật (AI không xác nhận)' })[(r.result && r.result.verdict && r.result.verdict.decision_source) || ''] || 'Không rõ')}`,\n  '',\n  `📝 <b>Chi tiết:</b>\\n${esc(reason)}`,\n  '',\n  `🔍 <b>Bằng chứng:</b> <code>${esc(ev)}</code>`,\n].join('\\n');\nreturn [{ json: { text } }];"
      }
    },
    {
      "id": "a1000000-0000-4000-8000-000000000005",
      "name": "Respond to Client",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [960, 0],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($('AI Analyze (Server /ingest)').item.json) }}",
        "options": {}
      }
    }
  ],
  "connections": {
    "Webhook windows-log": {
      "main": [[ { "node": "AI Analyze (Server /ingest)", "type": "main", "index": 0 } ]]
    },
    "AI Analyze (Server /ingest)": {
      "main": [[ { "node": "Is ALERT?", "type": "main", "index": 0 } ]]
    },
    "Is ALERT?": {
      "main": [
        [ { "node": "Build Alert Text", "type": "main", "index": 0 } ],
        [ { "node": "Respond to Client", "type": "main", "index": 0 } ]
      ]
    },
    "Build Alert Text": {
      "main": [[ { "node": "Telegram Alert", "type": "main", "index": 0 } ]]
    },
    "Telegram Alert": {
      "main": [[ { "node": "Respond to Client", "type": "main", "index": 0 } ]]
    }
  }
}
